# Supabase project settings — get these from Project Settings > API in your Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put your service_role key in a client app / this file if it's committed.
# It's only needed server-side (e.g. for a seed script run from your machine), not in the app.
SUPABASE_SERVICE_ROLE_KEY=only-for-local-seed-scripts-never-ship-this
